# Base Sepolia deployment (npm run setup:base-sepolia). Never commit a real .env.
DEPLOYER_PRIVATE_KEY=0x...            # funded with Base Sepolia ETH (faucet)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e   # Circle's test USDC instead of the demo token (the omnibus wallet must then be funded from the Circle faucet)
# PAYMASTER_DEPOSIT=0.02
# BUNDLER_FUNDING=0.01
# OMNIBUS_FUNDING=0.003
# MIN_DELAY=60
# RECOVERY_DELAY=300
# EXIT_DELAY=600
# HOLD_SECONDS=120
